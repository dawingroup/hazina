# Local development only. Copy to .env. Never put real client data in a non-production database.
# Owner role: runs migrations and seed (can bypass RLS).
DATABASE_URL=postgres://hazina_owner:hazina_owner@localhost:5432/hazina
# App role: what the API and worker use. Cannot bypass row-level security.
DATABASE_URL_APP=postgres://hazina_app:hazina_app@localhost:5432/hazina
REDIS_URL=redis://localhost:6379
# Firebase Auth emulator (docker compose). Remove in staging/prod.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-hazina
# Local S3-compatible storage (MinIO) standing in for Cloud Storage.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=hazina-documents
API_PORT=8080
# Shared with DawinOS to sign webhooks. Real value lives in Secret Manager.
DAWINOS_WEBHOOK_SECRET=local-dev-secret-change-me
# Web app
VITE_API_URL=http://localhost:8080
VITE_FIREBASE_PROJECT_ID=demo-hazina
VITE_FIREBASE_API_KEY=demo-key
VITE_USE_AUTH_EMULATOR=true
