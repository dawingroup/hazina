{
  "name": "hazina",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @hazina/db migrate",
    "db:seed": "pnpm --filter @hazina/db seed",
    "db:reset": "pnpm --filter @hazina/db reset",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "gate": "bash scripts/ci-gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
