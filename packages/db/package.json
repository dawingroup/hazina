{
  "name": "@hazina/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/reset.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "postgres": "^3.4.7",
    "@hazina/domain": "workspace:*"
  },
  "devDependencies": {
    "@hazina/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
